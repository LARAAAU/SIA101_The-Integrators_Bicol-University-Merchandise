# Copy this file to .env and fill in the values. NEVER commit .env or share it (zip, chat, screenshots).
# This example file must only ever contain placeholders. Run `npm run check:secrets` before you push or share the project.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # SECRET: backend only, never expose in frontend

# --- Online payment: pick ONE (leave the other blank) ---
# Maya Checkout SANDBOX (no sign-up): these are Maya's PUBLIC demo keys (published in their docs, not private).
# Copy the sandbox keys from
# https://developers.maya.ph/reference/sandbox-credentials-and-cards  ("Checkout" keys)
MAYA_PUBLIC_KEY=pk-Z0OSzLvIcOI2UIvDhdTGVVfRSSeiGStnceqwUE7n0Ah
MAYA_SECRET_KEY=sk-X8qolYjy62kIzEbr0QRK1h4b4KDVHaNcwMYk39jInSl
# MAYA_API_URL=https://pg-sandbox.paymaya.com
# PayMongo (GCash) if you ever get an account: use the TEST secret key
PAYMONGO_SECRET_KEY=
# Optional: force a provider (maya or paymongo). Otherwise it is detected from the keys above.
# PAYMENT_PROVIDER=maya

# --- Resend (resend.com > API Keys). Optional: emails are skipped if empty ---
RESEND_API_KEY=
MAIL_FROM=BICOL UNIVERSITY MERCHANDISE <onboarding@resend.dev>

# --- App ---
# Public URL of the app. Leave empty locally (auto-detected). On Vercel set to https://your-app.vercel.app
APP_URL=
# Optional: only allow registration from this email domain, e.g. bicolu.edu
ALLOWED_EMAIL_DOMAIN=
PORT=3000

# Optional: extra websites allowed to call the API from a browser (comma separated). The site itself needs none.
# CORS_ORIGINS=https://your-other-site.com

# --- Pickup reminders (emailed when an order is ready for pickup but not collected) ---
# Vercel Cron calls /api/cron/pickup-reminders daily and sends this secret. Set any long random string (required on Vercel).
CRON_SECRET=
# REMINDER_INTERVAL_DAYS=3   # days between reminders / wait before the first one when there is no pickup date
# REMINDER_MAX=3             # most reminders one order can get
